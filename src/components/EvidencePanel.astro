---
import type { Project } from '../data/projects';
import TechStackList from './TechStackList.astro';

interface Props { project: Project }
const { project } = Astro.props;
---

<aside class="evidence-panel" aria-label="Project evidence">
  <p class="eyebrow">Evidence</p>
  <h2>{project.evidenceLabel}</h2>
  {project.image && (
    <figure>
      <img src={project.image} alt={project.imageAlt} />
      {project.evidenceNote && <figcaption>{project.evidenceNote}</figcaption>}
    </figure>
  )}
  {project.repoUrl && (
    <p class="evidence-repo">
      <a href={project.repoUrl} rel="noreferrer">View repository →</a>
    </p>
  )}
  {project.repoNote && !project.repoUrl && (
    <p class="evidence-repo-note">{project.repoNote}</p>
  )}
  {project.tech.length > 0 && <TechStackList items={project.tech} />}
</aside>
