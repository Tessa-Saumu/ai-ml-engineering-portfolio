---
import type { Project } from '../data/projects';
import TechStackList from './TechStackList.astro';

interface Props { project: Project }
const { project } = Astro.props;
---

<aside class="evidence-panel" aria-label="Project evidence">
  <div class="evidence-heading">
    <p class="eyebrow">Evidence</p>
    <h2>{project.evidenceLabel}</h2>
  </div>
  {project.image ? (
    <figure>
      <img src={project.image} alt={project.imageAlt} />
      {project.evidenceNote && <figcaption>{project.evidenceNote}</figcaption>}
    </figure>
  ) : (
    <div class="evidence-empty">
      <div class="evidence-placeholder large" aria-hidden="true">
        <span>Raw data</span><i></i><span>Reasoning</span><i></i><span>PBIR</span>
      </div>
      <p>{project.evidenceNote}</p>
    </div>
  )}
  <div class="evidence-links">
    <span>Repository link</span>
    <span aria-label="Placeholder, link coming soon">Coming soon</span>
  </div>
  <TechStackList items={project.tech} />
</aside>
