---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props;

// Every summary opens with the project's problem statement, so split there to give the
// setup and the "what I built / what came of it" half their own paragraphs.
const opensWithProblem = project.summary.startsWith(project.problem);
const summaryProblem = opensWithProblem ? project.problem : null;
const summaryResponse = opensWithProblem
  ? project.summary.slice(project.problem.length).trim()
  : project.summary;
---

<article class:list={['project-card', { featured }]}>
  <div class="project-card-copy">
    <p class="project-number">{String(index + 1).padStart(2, '0')}</p>
    <h3>{project.title}</h3>
    {summaryProblem && <p class="project-summary-problem">{summaryProblem}</p>}
    <p class="project-summary-response">{summaryResponse}</p>
    <a class="text-link" href={`/projects/${project.slug}`}>Read the case study →</a>
  </div>
  <div class="project-card-visual">
    {project.image && (
      <img src={project.image} alt={project.imageAlt} loading="lazy" />
    )}
  </div>
</article>
