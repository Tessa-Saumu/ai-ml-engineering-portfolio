---
const pathname = Astro.url.pathname;
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/" aria-label="Theresia, home">THERESIA</a>
    <nav aria-label="Main navigation">
      <ul class="nav-list">
        {links.map((link) => (
          <li><a href={link.href} aria-current={pathname.startsWith(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
