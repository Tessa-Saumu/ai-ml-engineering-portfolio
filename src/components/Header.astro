---
const pathname = Astro.url.pathname;
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header" style="position: sticky; top: 0; background: var(--background); border-bottom: 1px solid var(--line);">
  <div class="shell header-inner" style="align-items: center; gap: 16px;">
    <a class="wordmark" href="/" aria-label="Theresia, home">THERESIA</a>
    <span class="hero-label">Applied AI/ML Engineer</span>
    <nav aria-label="Main navigation">
      <ul class="nav-list">
        {links.map((link) => (
          <li><a href={link.href} aria-current={pathname.startsWith(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
