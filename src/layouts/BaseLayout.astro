---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Social share preview (Open Graph for LinkedIn/Facebook/WhatsApp, Twitter card for X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Theresia Saumu" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/social-card.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Theresia Saumu, Applied AI and ML Engineer, against a green background." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/social-card.jpg', Astro.site)} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Sora:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="google-site-verification" content="lbmV_e1Hm_oyfSBxbdtmO9gl9ARpYHkHC1JFjjSHuDA" />
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yb3s80yscp");
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Progressive enhancement for the demo clips that replaced the old GIFs.
      // Baseline markup is `controls preload="none"`, so nothing downloads unprompted.
      // Here we restore the old GIF feel: silent autoplay while on screen, paused off screen.
      // Visitors who prefer reduced motion keep the controls and decide for themselves.
      (function () {
        var clips = document.querySelectorAll('video[data-autoplay]');
        if (!clips.length) return;

        var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still || !('IntersectionObserver' in window)) return;

        var seen = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var clip = entry.target;
            if (entry.isIntersecting) {
              clip.play().catch(function () { clip.controls = true; });
            } else {
              clip.pause();
            }
          });
        }, { rootMargin: '200px' });

        clips.forEach(function (clip) {
          clip.controls = false;
          seen.observe(clip);
        });
      })();
    </script>
    <!-- Cloudflare Web Analytics -->
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "437806dc3e2747d996f5bb6f2033335c"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
