---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact | Theresia" description="Contact Theresia about one scoped Applied AI problem.">
  <section class="simple-page shell">
    <div class="simple-grid">
      <h1>Contact</h1>
      <div class="simple-copy">
        <h2>Give me one problem you'd like solved by next week.</h2>
        <p>Give me one scoped problem. I'll spend a week building a solution and you can decide if you want me on the team.</p>
        <a class="primary-action" href="mailto:theresia.saumu@gmail.com">Email me →</a>
        <div class="link-row" aria-label="Social links">
          <a href="https://www.linkedin.com/in/theresia-saumu/" rel="noreferrer">LinkedIn</a>
          <a href="https://github.com/Tessa-Saumu" rel="noreferrer">GitHub →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
