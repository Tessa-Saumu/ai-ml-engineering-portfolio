---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Theresia Saumu | Applied AI & ML Engineer" description="Bring Theresia Saumu one scoped Applied AI problem. She spends a week building a working solution, and you decide from there.">
  <section class="simple-page shell">
    <div class="simple-grid">
      <h1>Contact</h1>
      <div class="simple-copy">
        <h2>Give me one problem you'd like solved by next week.</h2>
        <p>Give me one scoped problem. I'll spend a week building a solution and you can decide if you want me on the team.</p>

        {/*
          Netlify Forms: the attributes below are what Netlify detects at deploy time.
          - name="contact" is the form's ID in the Netlify dashboard
          - data-netlify="true" turns on Netlify's form handling (no server of ours needed)
          - netlify-honeypot="bot-field" enables the invisible anti-spam field
          - action="/thanks" is where visitors land if they submit without JavaScript
          - the hidden "subject" input sets the notification email's subject line
            (%{submissionId} is filled in by Netlify)
          Note: Netlify strips these attributes and injects its own form-name input when
          the site is deployed. That's expected, not a bug.
        */}
        <form class="contact-form" name="contact" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="subject" value={'New problem from your portfolio (%{submissionId})'} />
          <p hidden aria-hidden="true">
            <label>Leave this field empty: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="form-field">
            <label for="contact-name">Your name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="100" />
          </div>

          <div class="form-field">
            <label for="contact-email">Your email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="form-field">
            <label for="contact-company">Company (optional)</label>
            <input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="100" />
          </div>

          <div class="form-field">
            <label for="contact-problem">The problem you'd like solved</label>
            <textarea
              id="contact-problem"
              name="problem"
              rows="6"
              required
              maxlength="2000"
              placeholder="One scoped problem is enough. What needs to happen, and what's in the way."></textarea>
            <span class="char-count" id="problem-count">0 / 2,000 characters</span>
          </div>

          <button class="form-submit" type="submit">Send the problem →</button>
          <p class="form-note">Submissions land in my inbox. I reply from theresia.saumu@gmail.com.</p>
        </form>

        <div class="form-status" id="form-status" role="status" aria-live="polite"></div>

        <div class="link-row" aria-label="Other ways to reach me">
          <a href="mailto:theresia.saumu@gmail.com">Email me directly →</a>
          <a href="https://www.linkedin.com/in/theresia-saumu/" rel="noreferrer">LinkedIn</a>
          <a href="https://github.com/Tessa-Saumu" rel="noreferrer">GitHub →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: submit without leaving the page.
  // Netlify's form handler accepts a urlencoded POST to any static page on the site.
  // If JavaScript is unavailable, the form falls back to a normal POST + redirect to /thanks.
  const form = document.querySelector<HTMLFormElement>('form.contact-form');
  const statusBox = document.getElementById('form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  if (form && statusBox && button) {
    const nameInput = form.querySelector<HTMLInputElement>('#contact-name');
    const emailInput = form.querySelector<HTMLInputElement>('#contact-email');
    const problemInput = form.querySelector<HTMLTextAreaElement>('#contact-problem');

    // QA #4: show the 2,000-character budget filling up instead of silently truncating.
    const problemCount = document.getElementById('problem-count');
    const updateCount = () => {
      if (!problemInput || !problemCount) return;
      const length = problemInput.value.length;
      problemCount.textContent = `${length.toLocaleString('en')} / 2,000 characters`;
      problemCount.classList.toggle('is-near-limit', length >= 1800);
    };
    problemInput?.addEventListener('input', updateCount);
    updateCount();

    // Let our own friendly messages replace the browser's default popups (no-JS visitors still get native required checks).
    form.noValidate = true;

    // One helper so success and error messages share the same styled status box.
    const setStatus = (html: string, kind: 'success' | 'error') => {
      statusBox.className = `form-status is-${kind}`;
      statusBox.innerHTML = html;
    };

    const showSuccess = () => {
      // Keep the form visible (instead of hiding it) so the button can read "Sent".
      button.disabled = true;
      button.textContent = 'Sent';
      setStatus(
        '<h3>Thanks, message sent.</h3><p>I&rsquo;ll be in touch from theresia.saumu@gmail.com.</p>',
        'success',
      );
    };

    const showError = () => {
      setStatus(
        '<h3>That didn&rsquo;t send.</h3><p>Something went wrong delivering the message. Please try again, or <a href="mailto:theresia.saumu@gmail.com">email me directly</a>.</p>',
        'error',
      );
      button.disabled = false;
      button.textContent = 'Send the problem →';
    };

    // QA #9: a realistic address needs a dot and a 2+ letter TLD, so "a@b" cannot slip through.
    const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[A-Za-z]{2,}$/;
    // QA #2: a usable problem statement is at least a couple of words, not any single string.
    const PROBLEM_MIN_CHARS = 20;

    // Friendly pre-send checks: each missing piece gets its own nudge, and we return the field to focus.
    const validate = (): HTMLInputElement | HTMLTextAreaElement | null => {
      const value = (el: HTMLInputElement | HTMLTextAreaElement | null) => (el?.value ?? '').trim();
      if ([nameInput, emailInput, problemInput].every((el) => value(el) === '')) {
        setStatus('<p>Nothing to send yet. Add your name, email, and the problem, then press send.</p>', 'error');
        return nameInput ?? null;
      }
      const email = value(emailInput);
      if (email === '' || !EMAIL_PATTERN.test(email)) {
        setStatus('<p>I need a working email address to reply to. Add it above and try again.</p>', 'error');
        return emailInput ?? null;
      }
      if (value(nameInput).length < 2) {
        setStatus('<p>Add your name so I know who&rsquo;s writing.</p>', 'error');
        return nameInput ?? null;
      }
      const problem = value(problemInput);
      if (problem === '') {
        setStatus('<p>Don&rsquo;t forget the problem. A sentence or two is plenty.</p>', 'error');
        return problemInput ?? null;
      }
      if (problem.length < PROBLEM_MIN_CHARS || !/\S\s+\S/.test(problem)) {
        setStatus('<p>That&rsquo;s too short to work from. Describe the problem in a sentence or two.</p>', 'error');
        return problemInput ?? null;
      }
      return null;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button.disabled) return;

      const invalid = validate();
      if (invalid) {
        invalid.focus();
        return;
      }

      const data = new FormData(form);

      // Honeypot filled in: almost certainly a bot. Pretend it worked, send nothing.
      if ((data.get('bot-field') ?? '').toString().trim() !== '') {
        showSuccess();
        return;
      }

      button.disabled = true;
      button.textContent = 'Sending…';

      try {
        const body = new URLSearchParams();
        for (const [key, value] of data.entries()) {
          body.append(key, value.toString());
        }
        const response = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        if (!response.ok) throw new Error(`Submission failed with ${response.status}`);
        showSuccess();
      } catch {
        showError();
      }
    });
  }
</script>
