---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message received | Theresia" description="Thanks. Your message is on its way to Theresia's inbox.">
  <section class="simple-page shell">
    <div class="simple-grid">
      <h1>Thanks</h1>
      <div class="simple-copy">
        <h2>Message received.</h2>
        <p>Your message is on its way to my inbox. I&rsquo;ll reply from theresia.saumu@gmail.com.</p>
        <a class="primary-action" href="/">Back to home →</a>
      </div>
    </div>
  </section>
</BaseLayout>
