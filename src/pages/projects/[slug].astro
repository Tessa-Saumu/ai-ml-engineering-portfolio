---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyLayout from '../../components/CaseStudyLayout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<BaseLayout title={`Case study: ${project.title} | Theresia Saumu`} description={project.summary}>
  <CaseStudyLayout project={project} />
</BaseLayout>
