---
import BaseLayout from '../layouts/BaseLayout.astro';

const resumePdf = '/Theresia-Saumu-Applied-AI-ML-Engineer-CV.pdf';
// The CV is a single US Letter page (612 x 792pt). FitH plus that exact aspect ratio on the
// frame means the whole page is visible at once, with no scrollbar inside the embed.
const resumeEmbed = `${resumePdf}#view=FitH&toolbar=0&navpanes=0`;
---

<BaseLayout title="Resume | Theresia Saumu" description="Resume of Theresia Saumu, Applied AI and Machine Learning engineer. Her key projects are here too, alongside experience, education, and a downloadable CV.">
  <header class="page-intro shell">
    <h1>Resume</h1>
    <div class="page-intro-copy">
      <p class="lead">The whole CV on one page, below. Read it here, or take a copy with you.</p>
      <div class="link-row">
        <a href={resumePdf} target="_blank" rel="noopener">Open in a new tab →</a>
        <a href={resumePdf} download>Download the PDF →</a>
      </div>
    </div>
  </header>

  <section class="resume-doc shell" aria-labelledby="resume-doc-title">
    <h2 id="resume-doc-title" class="visually-hidden">Resume document</h2>

    {/*
      The 316 KB PDF is deliberately NOT referenced in the markup. `data` is only set by the
      script below, and only on viewports wide enough to read a full Letter page. CSS
      `display: none` would not have prevented the download - browsers still fetch hidden
      embeds - so the attribute has to be absent until we actually want the file.
    */}
    <div class="resume-frame-wrap" data-resume-embed hidden>
      <object
        class="resume-frame"
        data-src={resumeEmbed}
        type="application/pdf"
        aria-label="Resume of Theresia Saumu, Applied AI and Machine Learning Engineer. One page PDF."
      >
        <div class="resume-fallback">
          <p>This browser can't display the PDF inline.</p>
          <a class="primary-action" href={resumePdf} target="_blank" rel="noopener">Open the resume (PDF) →</a>
        </div>
      </object>
    </div>

    {/* Shown on phones and with JavaScript off: both cases get a real link, never a blank frame. */}
    <div class="resume-offer" data-resume-offer>
      <p>The CV is a single page. On a small screen it reads better full screen than in an embed.</p>
      <a class="primary-action" href={resumePdf} target="_blank" rel="noopener">Open the resume (PDF) →</a>
    </div>
  </section>

  <script is:inline>
    // Runs during parse so the embed is in place before first paint, no flash of the link card.
    (function () {
      var wrap = document.querySelector('[data-resume-embed]');
      var offer = document.querySelector('[data-resume-offer]');
      var frame = wrap && wrap.querySelector('.resume-frame');
      if (!wrap || !frame) return;

      // Matches the 800px breakpoint in global.css.
      var wide = window.matchMedia('(min-width: 801px)');

      function sync() {
        if (wide.matches) {
          // Setting `data` is what triggers the download, so it happens once, on demand.
          if (!frame.hasAttribute('data')) frame.setAttribute('data', frame.dataset.src);
          wrap.hidden = false;
          if (offer) offer.hidden = true;
        } else {
          wrap.hidden = true;
          if (offer) offer.hidden = false;
        }
      }

      sync();
      // addListener is the pre-Safari-14 spelling; keep both so older iPads still switch over.
      if (wide.addEventListener) wide.addEventListener('change', sync);
      else if (wide.addListener) wide.addListener(sync);
    })();
  </script>
</BaseLayout>
