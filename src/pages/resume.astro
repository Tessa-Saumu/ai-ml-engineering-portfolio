---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resume | Theresia" description="Theresia Saumu's resume and formal experience record.">
  <section class="simple-page shell">
    <div class="simple-grid">
      <div>
        <p class="eyebrow">Formal record</p>
        <h1>Resume</h1>
      </div>
      <div class="simple-copy">
        <span class="primary-action" aria-label="Resume link placeholder">View my resume →</span>
      </div>
    </div>
  </section>
</BaseLayout>
