---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Theresia" description="That page doesn't exist. Head back to Theresia's portfolio.">
  <section class="simple-page shell">
    <div class="simple-grid">
      <h1>Page not found</h1>
      <div class="simple-copy">
        <h2>That link didn't lead anywhere.</h2>
        <p>The page moved or never existed. My work and my contact details are one click away.</p>
        <a class="primary-action" href="/">Back to home →</a>
        <a class="text-link" href="/contact">Contact me →</a>
      </div>
    </div>
  </section>
</BaseLayout>
